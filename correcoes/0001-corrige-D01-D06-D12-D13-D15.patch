diff --git a/src/sentinela/features.py b/src/sentinela/features.py
index f3fcede..3272002 100644
--- a/src/sentinela/features.py
+++ b/src/sentinela/features.py
@@ -48,12 +48,11 @@ def risco_congelado() -> dict[str, float]:
 def _risco_por_maquina(df: pd.DataFrame) -> pd.Series:
     """Risco histórico do motor, usado como atributo categórico numérico.
 
-    Quando o lote já vem rotulado, recalculamos o risco no próprio lote para
-    refletir o comportamento mais recente da planta; sem rótulo, caímos na
-    tabela congelada.
+    Sempre a tabela congelada do treino. Recalcular com `falha_72h` do
+    próprio lote vazava o rótulo para a feature (D01). No treino as duas
+    coisas coincidem, então os modelos publicados não precisam ser
+    retreinados.
     """
-    if "falha_72h" in df.columns:
-        return df.groupby("id_maquina")["falha_72h"].transform("mean").astype(float)
     congelado = risco_congelado()
     padrao = sum(congelado.values()) / len(congelado)
     return df["id_maquina"].map(congelado).fillna(padrao).astype(float)
@@ -69,32 +68,44 @@ def construir(df: pd.DataFrame) -> pd.DataFrame:
     if faltando:
         raise ValueError(f"colunas ausentes para construir features: {sorted(faltando)}")
 
-    ordenado = df.sort_values(["id_maquina", "timestamp"])
+    # Trabalha sobre posições (0..n-1): um índice de entrada repetido
+    # duplicava linhas no `.loc[df.index]` final (D13).
+    trabalho = df.reset_index(drop=True)
+    ordenado = trabalho.sort_values(["id_maquina", "timestamp"], kind="mergesort")
     por_maquina = ordenado.groupby("id_maquina", sort=False)
+    instantes = pd.to_datetime(ordenado["timestamp"])
+
+    # Janelas em HORAS, não em linhas: quando `limpar` descarta uma leitura
+    # (eixo parado), "6 h" continuava contando 6 linhas (D12). Com a grade
+    # horária completa o resultado é idêntico ao anterior.
+    def janela(serie: pd.Series, horas: int, agregacao: str):
+        no_tempo = pd.Series(serie.to_numpy(), index=pd.DatetimeIndex(instantes.loc[serie.index]))
+        return getattr(no_tempo.rolling(f"{horas}h", min_periods=1), agregacao)().to_numpy()
+
+    def delta(serie: pd.Series, horas: int):
+        indice = pd.DatetimeIndex(instantes.loc[serie.index])
+        no_tempo = pd.Series(serie.to_numpy(), index=indice)
+        no_tempo = no_tempo[~no_tempo.index.duplicated(keep="last")]
+        anterior = no_tempo.reindex(indice - pd.Timedelta(hours=horas)).to_numpy()
+        return serie.to_numpy() - anterior
 
     saida = pd.DataFrame(index=ordenado.index)
 
     temperatura = por_maquina["temperatura_c"]
+    # Janela centrada: lê 2 h do futuro (D02). Corrigir exige retreinar os
+    # modelos, que aprenderam com esta definição — fica fora deste patch.
     saida["temp_media_6h"] = temperatura.transform(
         lambda s: s.rolling(JANELA_CURTA, center=True, min_periods=1).mean()
     )
-    saida["temp_max_24h"] = temperatura.transform(
-        lambda s: s.rolling(JANELA_LONGA, min_periods=1).max()
-    )
-    saida["delta_temp_24h"] = temperatura.transform(
-        lambda s: s - s.shift(JANELA_LONGA)
-    ).fillna(0.0)
+    saida["temp_max_24h"] = temperatura.transform(lambda s: janela(s, JANELA_LONGA, "max"))
+    saida["delta_temp_24h"] = temperatura.transform(lambda s: delta(s, JANELA_LONGA)).fillna(0.0)
 
     vibracao = por_maquina["vibracao_rms"]
-    saida["vib_media_6h"] = vibracao.transform(
-        lambda s: s.rolling(JANELA_CURTA, min_periods=1).mean()
-    )
-    saida["vib_max_24h"] = vibracao.transform(
-        lambda s: s.rolling(JANELA_LONGA, min_periods=1).max()
-    )
+    saida["vib_media_6h"] = vibracao.transform(lambda s: janela(s, JANELA_CURTA, "mean"))
+    saida["vib_max_24h"] = vibracao.transform(lambda s: janela(s, JANELA_LONGA, "max"))
 
     saida["corrente_media_6h"] = por_maquina["corrente_a"].transform(
-        lambda s: s.rolling(JANELA_CURTA, min_periods=1).mean()
+        lambda s: janela(s, JANELA_CURTA, "mean")
     )
 
     saida["pressao"] = ordenado["pressao"].astype(float)
@@ -107,4 +118,6 @@ def construir(df: pd.DataFrame) -> pd.DataFrame:
     saida["operador_senior"] = (ordenado["id_operador"] == OPERADOR_SENIOR).astype(float)
     saida["turno"] = ordenado["turno"].astype(float)
 
-    return saida.loc[df.index, list(ORDEM_FEATURES)]
+    resultado = saida.loc[trabalho.index, list(ORDEM_FEATURES)]
+    resultado.index = df.index
+    return resultado
diff --git a/src/sentinela/modelo.py b/src/sentinela/modelo.py
index 7edf174..464e8af 100644
--- a/src/sentinela/modelo.py
+++ b/src/sentinela/modelo.py
@@ -94,13 +94,17 @@ class Modelo:
         """Atalho para prever uma leitura só, a partir de um dicionário de features.
 
         É o caminho usado pelo painel da sala de controle, que recebe um
-        registro por vez.
+        registro por vez. Os valores são lidos PELO NOME da feature; a ordem
+        das chaves do dicionário não importa (D06).
         """
-        vetor = np.array([float(valor) for valor in registro.values()], dtype=np.float64)
-        if vetor.size != len(self.ordem_features):
+        faltando = set(self.ordem_features) - set(registro)
+        sobrando = set(registro) - set(self.ordem_features)
+        if faltando or sobrando:
             raise ValueError(
-                f"esperadas {len(self.ordem_features)} features, recebidas {vetor.size}"
+                f"registro não bate com as features do modelo: "
+                f"faltando {sorted(faltando)}, desconhecidas {sorted(sobrando)}"
             )
+        vetor = np.array([float(registro[nome]) for nome in self.ordem_features], dtype=np.float64)
         return int(self.prever(vetor.reshape(1, -1), limiar=limiar)[0])
 
 
