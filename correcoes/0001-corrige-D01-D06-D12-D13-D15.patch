From e8d9e2e76c7f99fb11f5d2c8981d3d81c6a1e6cf Mon Sep 17 00:00:00 2001
From: vcastro <vcastro.denis@gmail.com>
Date: Sun, 27 Sep 2026 18:31:23 -0300
Subject: [PATCH] Corrige D01, D06, D12, D13 e D15 (sem retreinar os modelos)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- D01: maquina_risco usa sempre a tabela congelada do treino; recalcular
  com falha_72h do lote vazava o rótulo para a feature.
- D06: prever_registro lê os valores pelo nome da feature e recusa
  dicionários com chaves faltando ou desconhecidas.
- D12: janelas de 6 h/24 h e delta de 24 h medidas em horas, não em linhas.
- D13: construir trabalha por posição; índice repetido não duplica linhas.
- D15: manifest regenerado sobre o conteúdo LF versionado e .gitattributes
  fixando eol=lf para dados/ e artefatos/.

D02, D03, D04 e D05 mudam as features com que os modelos foram treinados
e exigem retreino; ficam fora deste patch.
---
 .gitattributes            |  5 ++++
 artefatos/manifest.json   |  8 +++---
 src/sentinela/features.py | 53 ++++++++++++++++++++++++---------------
 src/sentinela/modelo.py   | 12 ++++++---
 4 files changed, 50 insertions(+), 28 deletions(-)
 create mode 100644 .gitattributes

diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..d863263
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,5 @@
+# O manifest.json guarda o sha256 destes arquivos com fim de linha LF.
+# Sem isto, o Git para Windows (core.autocrlf=true) os converte para CRLF
+# no checkout e o hash passa a depender do sistema operacional (D15).
+dados/*.csv text eol=lf
+artefatos/*.json text eol=lf
diff --git a/artefatos/manifest.json b/artefatos/manifest.json
index dd9e5d6..ca5c1b2 100644
--- a/artefatos/manifest.json
+++ b/artefatos/manifest.json
@@ -2,11 +2,11 @@
   "gerado_em": "2026-09-08T08:19:45",
   "semente": 42,
   "arquivos": {
-    "dados/treino.csv": "c451a57533172af5146d06db3272591a21ff4e6af3030c266a593e88bfe6bf56",
-    "dados/teste.csv": "73124899eff5e5b0c84ead552f7f73f5739b4723c7815a0dc57d7566797d5830",
-    "dados/producao.csv": "96c55056c8b89c92348036157dbf6f7b77ed22ca86165a52c77b3400380bf56b",
+    "dados/treino.csv": "8686bdae41bb60e52ca7b4004252fb996506b1f4f3c5b331f25ba5b9899cd64d",
+    "dados/teste.csv": "acaed09d75a34446b0add22dd76aa6779120fca5440e342096ea225a25815d91",
+    "dados/producao.csv": "4fb7dae133420d8bc5dd46a180c0437dd035bac9b85141b4295f1664307034b1",
     "artefatos/modelo_v1.json": "1f5fe29a5cbf75bad31c1bdf38c3f6eee8f68bb4c80b86a372ffd90f374ffd6e",
     "artefatos/modelo_v2.json": "cac035ef1d0ab4a75a6e4d2d399fdef46271dde5d58d5d1e84b7686b3026e611",
-    "artefatos/risco_maquina.json": "34c467594843bda41e7fd12c5ae62d3dacf417d94c9d2498ee9cf5e8af493655"
+    "artefatos/risco_maquina.json": "2927fca7e649d0b8e3dc3c467cc11ac9f3d2e1aced06e3f5e7f88457834b948c"
   }
 }
